"doc://SwiftSMTPVapor/documentation/SwiftSMTPVapor/PrecomposedEmail": {
  "abstract" : [
    {
      "text" : "Represents an email whose message is pre-composed (e.g. a pre-built RFC 2822 payload).",
      "type" : "text"
    },
    {
      "text" : " ",
      "type" : "text"
    },
    {
      "text" : "Use this type when the canonical RFC 2822 bytes for the message already exist, e.g. when the same bytes",
      "type" : "text"
    },
    {
      "text" : " ",
      "type" : "text"
    },
    {
      "text" : "must be delivered to SMTP ",
      "type" : "text"
    },
    {
      "code" : "DATA",
      "type" : "codeVoice"
    },
    {
      "text" : " and stored verbatim via IMAP ",
      "type" : "text"
    },
    {
      "code" : "APPEND",
      "type" : "codeVoice"
    },
    {
      "text" : ", when the message has been DKIM-signed and",
      "type" : "text"
    },
    {
      "text" : " ",
      "type" : "text"
    },
    {
      "text" : "must not be re-serialised, or when forwarding a message retrieved from another mail store.",
      "type" : "text"
    }
